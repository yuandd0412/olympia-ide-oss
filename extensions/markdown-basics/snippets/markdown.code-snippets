{
	"Insert bold text": {
		"prefix": "bold",
		"body": "**${1:${TM_SELECTED_TEXT}}**$0",
		"description": "加粗文字"
	},
	"Insert italic text": {
		"prefix": "italic",
		"body": "*${1:${TM_SELECTED_TEXT}}*$0",
		"description": "斜体文字"
	},
	"Insert quoted text": {
		"prefix": "quote",
		"body": "${1:${TM_SELECTED_TEXT/^/> /gm}}",
		"description": "引用（每行前加 >）"
	},
	"Insert inline code": {
		"prefix": "code",
		"body": "`${1:${TM_SELECTED_TEXT}}`$0",
		"description": "行内代码"
	},
	"Insert fenced code block": {
		"prefix": "fenced codeblock",
		"body": ["```${1|python,c,c++,c#,ruby,go,java,php,htm,css,javascript,json,markdown,console|}", "${TM_SELECTED_TEXT}$0", "```"],
		"description": "代码块（可选语言）"
	},
	"Insert heading level 1": {
		"prefix": "heading1",
		"body": "# ${1:${TM_SELECTED_TEXT}}",
		"description": "一级标题"
	},
	"Insert heading level 2": {
		"prefix": "heading2",
		"body": "## ${1:${TM_SELECTED_TEXT}}",
		"description": "二级标题"
	},
	"Insert heading level 3": {
		"prefix": "heading3",
		"body": "### ${1:${TM_SELECTED_TEXT}}",
		"description": "三级标题"
	},
	"Insert heading level 4": {
		"prefix": "heading4",
		"body": "#### ${1:${TM_SELECTED_TEXT}}",
		"description": "四级标题"
	},
	"Insert heading level 5": {
		"prefix": "heading5",
		"body": "##### ${1:${TM_SELECTED_TEXT}}",
		"description": "五级标题"
	},
	"Insert heading level 6": {
		"prefix": "heading6",
		"body": "###### ${1:${TM_SELECTED_TEXT}}",
		"description": "六级标题"
	},
	"Insert unordered list": {
		"prefix": "unordered list",
		"body": ["- ${1:first}", "- ${2:second}", "- ${3:third}", "$0"],
		"description": "无序列表"
	},
	"Insert ordered list": {
		"prefix": "ordered list",
		"body": ["1. ${1:first}", "2. ${2:second}", "3. ${3:third}", "$0"],
		"description": "有序列表"
	},
	"Insert horizontal rule": {
		"prefix": "horizontal rule",
		"body": "----------\n",
		"description": "分隔线"
	},
	"Insert link": {
		"prefix": "link",
		"body": "[${TM_SELECTED_TEXT:${1:text}}](${2:https://})$0",
		"description": "链接"
	},
	"Insert image": {
		"prefix": "image",
		"body": "![${TM_SELECTED_TEXT:${1:alt}}](${2:https://})$0",
		"description": "图片"
	},
	"Insert strikethrough": {
		"prefix": "strikethrough",
		"body": "~~${1:${TM_SELECTED_TEXT}}~~",
		"description": "删除线"
	},
	"Insert inline math": {
		"prefix": [
			"inline math"
		],
		"body": "$${1:${TM_SELECTED_TEXT}}$",
		"description": "行内公式"
	},
	"Insert fenced math": {
		"prefix": [
			"fenced math"
		],
		"body": [
			"$$",
			"${1:${TM_SELECTED_TEXT}}",
			"$$"
		],
		"description": "公式块"
	}
}
