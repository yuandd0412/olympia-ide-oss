{
	"name": "contest",
	"displayName": "Olympia 竞赛助手",
	"description": "题面拉取（洛谷 / Codeforces / AtCoder）、赛制模板、样例用例管理。",
	"version": "0.1.0",
	"publisher": "olympia",
	"license": "GPL-3.0-or-later",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other",
		"Education"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:olympia-contest"
	},
	"contributes": {
		"commands": [
			{
				"command": "olympia.problem.pull",
				"title": "拉取题面...",
				"category": "Olympia",
				"icon": "$(cloud-download)"
			},
			{
				"command": "olympia.problem.pullFromClipboard",
				"title": "从剪贴板拉取题号",
				"category": "Olympia"
			},
			{
				"command": "olympia.template.insert",
				"title": "插入赛制模板...",
				"category": "Olympia",
				"icon": "$(file-code)"
			},
			{
				"command": "olympia.template.editMy",
				"title": "编辑我的模板",
				"category": "Olympia",
				"icon": "$(edit)"
			},
			{
				"command": "olympia.problem.openStatement",
				"title": "打开题面库",
				"category": "Olympia"
			},
			{
				"command": "olympia.problem.openSource",
				"title": "打开原题网页",
				"category": "Olympia",
				"icon": "$(link-external)"
			},
			{
				"command": "olympia.problem.appendSample",
				"title": "给这道题加一组自定义样例",
				"category": "Olympia",
				"enablement": "true"
			},
			{
				"command": "olympia.practice.open",
				"title": "集训清单",
				"category": "Olympia",
				"icon": "$(list-unordered)"
			},
			{
				"command": "olympia.practice.new",
				"title": "新建集训清单",
				"category": "Olympia"
			},
			{
				"command": "olympia.statement.show",
				"title": "显示题面（侧栏）",
				"category": "Olympia",
				"icon": "media/olympia-statement.svg"
			},
			{
				"command": "olympia.statement.refresh",
				"title": "题面：重新读一次文件",
				"category": "Olympia",
				"icon": "$(refresh)"
			},
			{
				"command": "olympia.statement.openRaw",
				"title": "题面：以文本方式打开（改题面用）",
				"category": "Olympia",
				"icon": "$(go-to-file)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "olympiaStatement",
					"title": "题面",
					"icon": "media/olympia-statement.svg"
				}
			]
		},
		"views": {
			"olympiaStatement": [
				{
					"id": "olympia.statement",
					"name": "题面",
					"type": "webview",
					"visibility": "visible",
					"icon": "media/olympia-statement.svg",
					"contextualTitle": "Olympia 题面"
				}
			]
		},
		"menus": {
			"commandPalette": [
			{
				"command": "olympia.problem.receiveHandoff",
				"when": "false"
			},
				{
					"command": "olympia.problem.pull",
					"when": "true"
				},
				{
					"command": "olympia.problem.pullFromClipboard",
					"when": "true"
				},
				{
					"command": "olympia.template.insert",
					"when": "editorLangId == cpp"
				},
				{
					"command": "olympia.template.editMy",
					"when": "true"
				},
				{
					"command": "olympia.problem.openStatement",
					"when": "true"
				},
				{
					"command": "olympia.problem.openSource",
					"when": "true"
				},
				{
					"command": "olympia.problem.appendSample",
					"when": "true"
				},
				{
					"command": "olympia.practice.open",
					"when": "true"
				},
				{
					"command": "olympia.practice.new",
					"when": "true"
				},
				{
					"command": "olympia.statement.show",
					"when": "true"
				},
				{
					"command": "olympia.statement.refresh",
					"when": "true"
				},
				{
					"command": "olympia.statement.openRaw",
					"when": "true"
				}
			],
			"view/title": [
				{
					"command": "olympia.statement.refresh",
					"group": "navigation@1",
					"when": "view == olympia.statement"
				},
				{
					"command": "olympia.statement.openRaw",
					"group": "navigation@2",
					"when": "view == olympia.statement"
				},
				{
					"command": "olympia.problem.pull",
					"group": "navigation@3",
					"when": "view == olympia.statement"
				}
			],
			"editor/title": [
				{
					"command": "olympia.problem.pull",
					"group": "navigation@5",
					"when": "resourceLangId == cpp || resourceLangId == c"
				},
				{
					"command": "olympia.template.insert",
					"group": "navigation@6",
					"when": "resourceLangId == cpp || resourceLangId == c"
				}
			],
			"explorer/context": [
				{
					"command": "olympia.problem.pull",
					"group": "7_modification@1"
				}
			],
			"editor/context": [
				{
					"command": "olympia.problem.openSource",
					"when": "resourceLangId == cpp || resourceLangId == c || resourceLangId == markdown",
					"group": "1_olympia@1"
				}
			],
			"editor/title/context": [
				{
					"command": "olympia.template.insert",
					"when": "resourceLangId == cpp",
					"group": "1_olympia@1"
				}
			]
		},
		"keybindings": [
			{
				"command": "olympia.problem.pull",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p"
			},
			{
				"command": "olympia.problem.pullFromClipboard",
				"key": "ctrl+alt+v",
				"mac": "cmd+alt+v",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.template.insert",
				"key": "ctrl+alt+t",
				"mac": "cmd+alt+t",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.problem.openStatement",
				"key": "ctrl+alt+o",
				"mac": "cmd+alt+o",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.problem.openSource",
				"key": "ctrl+alt+u",
				"mac": "cmd+alt+u",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.practice.open",
				"key": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "olympia.statement.show",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m"
			}
		],
		"configuration": {
			"title": "题面与模板",
			"properties": {
				"olympia.problem.problemsDir": {
					"type": "string",
					"default": ".olympia/problems",
					"description": "拉取的题面保存目录（相对于工作区根目录）。"
				},
				"olympia.problem.templateOnPull": {
					"type": "boolean",
					"default": false,
					"description": "拉取题面后是否在题面旁边自动新建一个同名 .cpp 文件。有「我的模板」就用你自己那份打底，没有就用 ACM 模板。"
				},
				"olympia.problem.requestTimeoutMs": {
					"type": "number",
					"default": 15000,
					"description": "拉取题面时的网络请求超时时间（毫秒）。"
				},
				"olympia.problem.cfMetadata": {
					"type": "boolean",
					"default": false,
					"description": "拉取 Codeforces 题目时是否额外查询标题、标签与难度。Codeforces 的题面网页有人机校验无法自动抓取，此选项只能补齐元数据，且需要下载约 10 MB 的题目表，因此默认关闭。"
				},
				"olympia.templates.cppSnippets": {
					"type": "boolean",
					"default": true,
					"description": "在 C++ 文件里补出竞赛常用写法：快速 IO、freopen、lower_bound、并查集、快速幂、Dijkstra 等。关掉后只剩普通的单词补全。"
				}
			}
		}
	}
}