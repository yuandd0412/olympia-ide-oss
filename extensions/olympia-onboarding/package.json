{
	"name": "onboarding",
	"displayName": "Olympia 引导与竞赛工具",
	"description": "Olympia IDE 内置引导：竞赛编译模式、环境自检、提交前体检、官网入口。",
	"version": "0.1.0",
	"publisher": "olympia",
	"license": "GPL-3.0-or-later",
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:olympia-onboarding"
	},
	"contributes": {
		"commands": [
			{
				"command": "olympia.checkEnvironment",
				"title": "环境自检：检测内置编译器",
				"category": "Olympia"
			},
			{
				"command": "olympia.openWebsite",
				"title": "打开 Olympia 官网",
				"category": "Olympia"
			},
			{
				"command": "olympia.pickCompileProfile",
				"title": "选择评测机编译配置",
				"category": "Olympia"
			},
			{
				"command": "olympia.preSubmitCheck",
				"title": "提交前体检",
				"category": "Olympia",
				"icon": "$(check)"
			},
			{
				"command": "olympia.stressTest",
				"title": "对拍（正解 vs 暴力）",
				"category": "Olympia",
				"icon": "$(sync-again)"
			},
			{
				"command": "olympia.contestMode",
				"title": "比赛模式（倒计时）",
				"category": "Olympia",
				"icon": "$(clock)"
			},
			{
				"command": "olympia.judgeSamples",
				"title": "跑样例（本地评测）",
				"category": "Olympia",
				"icon": "$(checklist)"
			},
			{
				"command": "olympia.compile",
				"title": "编译当前文件（按评测机参数）",
				"category": "Olympia",
				"icon": "$(tools)"
			},
			{
				"command": "olympia.compileJudgeAccurate",
				"title": "按评测机编译（强制 -O2）",
				"category": "Olympia",
				"icon": "$(server-process)"
			},
			{
				"command": "olympia.compileAndRun",
				"title": "编译并运行（本地样例测试）",
				"category": "Olympia",
				"icon": "$(play)"
			},
			{
				"command": "olympia.tools.refresh",
				"title": "刷新 Olympia 工具面板",
				"category": "Olympia",
				"icon": "$(refresh)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "olympia",
					"title": "Olympia",
					"icon": "media/olympia-tools.svg"
				}
			]
		},
		"views": {
			"olympia": [
				{
					"id": "olympia.tools",
					"name": "竞赛工具",
					"type": "tree",
					"visibility": "visible"
				}
			]
		},
		"menus": {
			"editor/title": [
				{
					"command": "olympia.compileAndRun",
					"group": "navigation@1",
					"when": "resourceLangId == cpp || resourceLangId == c"
				},
				{
					"command": "olympia.compile",
					"group": "navigation@2",
					"when": "resourceLangId == cpp || resourceLangId == c"
				},
				{
					"command": "olympia.compileJudgeAccurate",
					"group": "navigation@3",
					"when": "resourceLangId == cpp || resourceLangId == c"
				},
				{
					"command": "olympia.preSubmitCheck",
					"group": "navigation@4",
					"when": "resourceLangId == cpp || resourceLangId == c"
				}
			],
			"view/title": [
				{
					"command": "olympia.tools.refresh",
					"group": "navigation",
					"when": "view == olympia.tools"
				}
			],
			"commandPalette": [
				{
					"command": "olympia.tools.refresh",
					"when": "false"
				}
			]
		},
		"keybindings": [
			{
				"command": "olympia.compileAndRun",
				"key": "f9",
				"mac": "f9",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.compile",
				"key": "shift+f9",
				"mac": "shift+f9",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.compileJudgeAccurate",
				"key": "ctrl+shift+f9",
				"mac": "cmd+shift+f9",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.preSubmitCheck",
				"key": "ctrl+alt+enter",
				"mac": "cmd+alt+enter",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.stressTest",
				"key": "ctrl+alt+s",
				"mac": "cmd+alt+s"
			},
			{
				"command": "olympia.contestMode",
				"key": "ctrl+alt+c",
				"mac": "cmd+alt+c"
			},
			{
				"command": "olympia.judgeSamples",
				"key": "ctrl+alt+j",
				"mac": "cmd+alt+j",
				"when": "editorTextFocus"
			},
			{
				"command": "olympia.checkEnvironment",
				"key": "ctrl+alt+d",
				"mac": "cmd+alt+d"
			}
		],
		"walkthroughs": [
			{
				"id": "olympia.gettingStarted",
				"title": "三分钟上手 Olympia IDE",
				"description": "装完就能编译 C++、运行程序，不用手写 tasks.json。\n\n[访问 Olympia 官网](https://olympia.dpdns.org)",
				"when": "!isWeb",
				"steps": [
					{
						"id": "olympia.step.openFolder",
						"title": "打开或新建你的工程目录",
						"description": "所有竞赛代码建议放在一个独立的工程文件夹里，方便统一编译配置和模板管理。\n\n[打开文件夹](command:workbench.action.files.openFolder)",
						"media": {
							"altText": "工程目录里的源文件列表",
							"markdown": "media/openFolder.svg"
						},
						"completionEvents": [
							"onCommand:workbench.action.files.openFolder"
						]
					},
					{
						"id": "olympia.step.pickProfile",
						"title": "选择评测机编译配置",
						"description": "Olympia 内置了各评测机的真实编译参数。选一个预设，就不用自己拼 g++ 命令行了。\n\n[选择编译配置](command:olympia.pickCompileProfile)",
						"media": {
							"altText": "编译配置选择列表",
							"markdown": "media/pickProfile.svg"
						},
						"completionEvents": [
							"onCommand:olympia.pickCompileProfile"
						]
					},
					{
						"id": "olympia.step.checkEnv",
						"title": "跑一次环境自检",
						"description": "确认编译器就绪，并看看当前版本和目标评测机是否一致。\n\n[立即自检](command:olympia.checkEnvironment)",
						"media": {
							"altText": "环境自检结果列表",
							"markdown": "media/checkEnv.svg"
						},
						"completionEvents": [
							"onCommand:olympia.checkEnvironment"
						]
					},
					{
						"id": "olympia.step.askCoach",
						"title": "让 AI 教练看一遍代码",
						"description": "先给它配一个模型（本地 Ollama，或你自己的 API 密钥），然后在聊天里用 @coach 提问：`/wa` 找错因、`/hint` 只要思路、`/check` 提交前检查。\n\n[选择模型](command:olympia.coach.selectModel)",
						"media": {
							"altText": "在聊天里向 @coach 提问",
							"markdown": "media/askCoach.svg"
						},
						"completionEvents": [
							"onCommand:olympia.coach.selectModel"
						]
					},
					{
						"id": "olympia.step.website",
						"title": "了解更多",
						"description": "文档、下载与更新日志都在官网。\n\n[打开官网](https://olympia.dpdns.org)",
						"media": {
							"altText": "Olympia 官网",
							"markdown": "media/website.svg"
						},
						"completionEvents": [
							"onLink:https://olympia.dpdns.org"
						]
					}
				]
			},
			{
				"id": "olympia.compiler",
				"title": "内置编译器与环境自检",
				"description": "确认编译器就绪，并看清本机版本和评测机的差异。",
				"when": "!isWeb",
				"steps": [
					{
						"id": "olympia.compiler.check",
						"title": "一键环境自检",
						"description": "检测 g++ 是否可用、版本号是多少，以及和洛谷 / NOI 官方环境是否匹配。\n\n[立即自检](command:olympia.checkEnvironment)",
						"media": {
							"altText": "编译器版本检测结果",
							"markdown": "media/compilerCheck.svg"
						},
						"completionEvents": [
							"onCommand:olympia.checkEnvironment"
						]
					}
				]
			}
		],
		"configuration": {
			"title": "Olympia",
			"properties": {
				"olympia.compiler.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "自定义 `g++` 可执行文件路径。留空则使用系统 PATH 中的 g++。"
				},
				"olympia.compiler.profile": {
					"type": "string",
					"enum": [
						"luogu",
						"noi",
						"custom"
					],
					"enumDescriptions": [
						"洛谷默认：GCC 15.1.0 / C++23，评测环境定义 ONLINE_JUDGE=luogu",
						"NOI 官方：GCC 9.3.0 / C++14，符合 CCF NOI Linux 2.0 竞赛环境",
						"自定义：由你自己指定编译参数"
					],
					"default": "luogu",
					"markdownDescription": "竞赛编译配置。切换后按对应评测机的真实参数编译，避免「本地 AC、赛场 WA」。"
				},
				"olympia.compiler.customFlags": {
					"type": "string",
					"default": "",
					"markdownDescription": "`olympia.compiler.profile` 为 `custom` 时使用的额外编译参数。"
				},
				"olympia.compiler.optimization": {
					"type": "string",
					"enum": [
						"none",
						"-O2",
						"-O3"
					],
					"enumDescriptions": [
						"不优化（调试用）。评测机按题目设置可能开 -O2，本地保持关闭便于单步调试",
						"-O2：洛谷标准优化级别，绝大多数题目的评测环境",
						"-O3：更激进的优化，仅在确实需要时开启"
					],
					"default": "none",
					"markdownDescription": "优化级别。**本地调试建议保持 `none`**——洛谷改过 GCC，源码里用 `#pragma GCC optimize` 或 `__attribute__((optimize))` 打开优化会直接编译失败。"
				},
				"olympia.compiler.showCompileCommand": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "编译时把完整的 `g++` 命令行打印到终端，方便对照评测机参数排查。"
				},
				"olympia.debug.showEntryPoints": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "显示 VS Code 自带的「运行或调试」按钮和「运行」菜单。Olympia 默认关闭：F9 走内置编译运行，安装包里没有调试器。需要单步调试时再打开。"
				},
				"olympia.check.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "启用提交前体检：只报**会在评测机上编译失败**的写法，不当代码风格老师。"
				},
				"olympia.check.onSave": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "保存时自动运行体检。关闭后只能手动执行「提交前体检」命令。"
				},
				"olympia.check.rules.pragmaOptimize": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "检查 `#pragma GCC optimize` / `__attribute__((optimize))`——洛谷改过的 GCC 在开启优化时会直接拒绝这类写法。"
				},
				"olympia.check.rules.reservedWord": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "检查 MSVC 允许当变量名、GNU C++ 却是关键字的名字：`asm` 与 `and`、`or`、`not`、`xor` 等替代运算符。"
				},
				"olympia.stress.rounds": {
					"type": "number",
					"default": 100,
					"minimum": 1,
					"markdownDescription": "对拍轮数。每一轮用生成器产一组数据，同时喂给正解和暴力。"
				},
				"olympia.stress.timeoutMs": {
					"type": "number",
					"default": 2000,
					"minimum": 200,
					"markdownDescription": "对拍时单个程序的运行上限（毫秒）。超过就算不一致，并把那组数据存进 `stress-fail`。"
				},
				"olympia.check.rules.removedCpp": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "检查已被 C++ 标准移除的写法：`gets`、`random_shuffle`、`register`。"
				}
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/yuandd0412/olympia-ide"
	}
}
